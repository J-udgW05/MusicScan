<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MusicScanIntegrity.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- WPF is essential here: these tests exercise dependency property and
         animation behaviour that cannot be reproduced without it. -->
    <UseWPF>true</UseWPF>

    <!-- The app builds only as self-contained win-x64; the tests reference it,
         so the platform must match. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MusicScanIntegrity.App\MusicScanIntegrity.App.csproj" />
  </ItemGroup>

  <!-- Token dictionaries are copied from source as-is, so tests check the exact
       file the app ships. Loading them from assembly resources is impossible:
       pack:// URIs need a live Application, which tests do not have. -->
  <ItemGroup>
    <Content Include="..\..\src\MusicScanIntegrity.App\Resources\Tokens.*.xaml"
             Link="Tokens\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
