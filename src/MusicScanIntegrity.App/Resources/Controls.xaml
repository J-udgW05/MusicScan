<!--
    Control styles. Geometry (radii, padding, sizes) and hover behaviour follow
    the design mock-up. Borders are always 1 px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MusicScanIntegrity.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Focus ring ────────────────────────────────────────────────────
         Custom button templates drop the system dotted focus rectangle, which
         leaves keyboard navigation blind. WPF only shows this for keyboard focus. -->
    <Style x:Key="Focus.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2"
                               RadiusX="8" RadiusY="8"
                               Stroke="{DynamicResource Brush.Acc}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Radii ────────────────────────────────────────────────────────── -->
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">5</CornerRadius>
    <!-- The pill radius is a number, not "999": unlike CSS, WPF does not clamp an
         oversized CornerRadius to half the side but shrinks all four arcs
         proportionally, giving a lens instead of a capsule. Value = half height. -->
    <CornerRadius x:Key="Radius.Pill">15.5</CornerRadius>

    <!-- ── Card ───────────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    </Style>

    <Style x:Key="Card.Padded" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ── Buttons ────────────────────────────────────────────────────── -->

    <!-- Shared template: rounded rectangle with content. Content alignment comes
         from the button itself: almost everything wants centre, but a stretched
         link button wants the left edge, and a hard-coded centre left a gap. -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    </Style>

    <!-- Accent: the only filled button on the toolbar. -->
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccFg}" />

        <!-- The edge differs from the fill; otherwise it jumps from background
             straight to the bright colour and rounded corners look stepped. -->
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccBorder}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="Button.Outline" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="Padding" Value="13,8" />
    </Style>

    <!-- Scan control buttons sit on a recessed surface. -->
    <Style x:Key="Button.Soft" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Destructive action: outline with error-coloured text. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="Button.DangerFilled" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Err}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Err}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="18,8" />
    </Style>

    <!-- Borderless: Help, About. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="Padding" Value="12,8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bd2}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Link action inside a card, and the only place the cursor becomes a hand:
         on Windows a hand means a link, while buttons, toggles, tabs and list rows
         keep the arrow. A hand everywhere is a web habit that made every point of
         the window look clickable. -->
    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ── Text inputs ────────────────────────────────────────────────── -->
    <Style x:Key="TextBox.Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Tab}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <!-- Padding comes from the TextBox itself: WPF applies it to the content in
                             PART_ContentHost. Repeating it as a Margin doubles it, making the box
                             56 px tall instead of 38. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                        <!-- A disabled box must look disabled, or it is unclear why it rejects input. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Box without its own chrome: the container draws border and background. An
         explicit style is needed because the library TextBox has its own
         background that would otherwise show over the placeholder. -->
    <Style x:Key="TextBox.Bare" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="Transparent"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Combo box ──────────────────────────────────────────────────── -->
    <Style x:Key="ComboBox.Pill" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <!-- A fixed 104 px fits the longest value but leaves "60 s" floating in empty
             space. Width follows content; the right edges still align because the
             combo boxes are right-aligned. -->
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- The pill background is a separate Border rather than the button: the
                             ToggleButton has an implicit WPF-UI style that overrides sizes and
                             collapses the border. -->
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Chip}"
                                SnapsToDevicePixels="True" />

                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <!-- Chevron only on genuine drop-downs. -->
                            <controls:MsIcon Grid.Column="1" Kind="chevron-down" Size="12" Opacity="0.6"
                                             Margin="7,0,0,0" VerticalAlignment="Center"
                                             Foreground="{TemplateBinding Foreground}" />
                        </Grid>

                        <!-- Transparent button on top, only to catch clicks. -->
                        <ToggleButton x:Name="Toggle"
                                      Style="{x:Null}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               VerticalOffset="4"
                               MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Flyout}"
                                    BorderBrush="{DynamicResource Brush.Bd}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Padding="4"
                                    Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
                    <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        CornerRadius="{StaticResource Radius.Chip}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bd2}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle switch ────────────────────────────────────────────────
         Uses the real Windows 11 geometry: 40×20 track, 12×12 knob inset by 4,
         smooth travel and a knob that grows while pressed. The off state is an
         outline with a near-transparent fill, as in the system control, rather
         than the solid grey of the mock-up. -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10"
                                Background="{DynamicResource Brush.Card2}"
                                BorderBrush="{DynamicResource Brush.Fg3}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True" />

                        <!-- Knob travel is driven from code (controls:Motion.Knob). A template
                             storyboard is frozen, its duration cannot change at runtime, and two
                             prepared branches for one movement drift apart when the animations
                             setting changes. -->
                        <Border x:Name="Knob" Width="12" Height="12" CornerRadius="6"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                Background="{DynamicResource Brush.Fg2}"
                                controls:Motion.Knob="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- On-state colours: not animated and independent of the setting. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.AccBorder}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.AccFg}" />
                        </Trigger>

                        <!-- Hover: the off track gets slightly denser, the on track slightly lighter. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Bd2}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Fg}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </MultiTrigger>

                        <!-- Press: the knob stretches slightly, as in the system control. A named
                             transform cannot be set through a Setter, hence an animation. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="controls:Motion.Enabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.3" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="controls:Motion.Enabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.3" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Knob" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Check box 16×16, radius 4 ──────────────────────────────────── -->
    <Style x:Key="CheckBox.Square" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  Data="m5.4 10.3 2.9 2.9 6.3-7"
                                  Stroke="{DynamicResource Brush.AccFg}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="None" RenderTransformOrigin="0,0">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Export dialog radio button: 15×15 with a thick ring ────────── -->
    <Style x:Key="Radio.Dot" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card"
                            Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.Bd}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="13,11">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="15" Height="15" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Card2}"
                                     Stroke="{DynamicResource Brush.Bd}" StrokeThickness="1" />
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Dot" Property="StrokeThickness" Value="4" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Card}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Choice among equal options (theme) ─────────────────────────── -->
    <Style x:Key="ThemeChoice" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="8" Padding="11"
                            Background="{DynamicResource Brush.Card2}"
                            BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Format chip: on is a plain chip, off is muted. State is not
         conveyed by colour alone: the text of an off chip is struck through. -->
    <Style x:Key="Chip.Format" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.Chip}"
                            Background="{DynamicResource Brush.Card2}"
                            BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                            Padding="9,5" SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{DynamicResource Brush.Fg2}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Drop zone ───────────────────────────────────────────────────
         A working area, not a picture: it is clickable, so it highlights with the
         accent under the cursor and shows a hand. The dashes are a Rectangle
         because Border cannot draw a dashed outline. -->
    <Style x:Key="Drop.Zone" TargetType="Button">
        <Setter Property="Height" Value="132" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Frame" RadiusX="8" RadiusY="8" StrokeThickness="1.5"
                                   StrokeDashArray="4 3"
                                   Stroke="{DynamicResource Brush.Bd}"
                                   Fill="{DynamicResource Brush.Card2}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource Brush.Card2}" />
                        </Trigger>
                        <!-- A folder is dragged over the window: the zone lights up with it. -->
                        <DataTrigger Binding="{Binding IsDragActive}" Value="True">
                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource Brush.AccSoft}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Action card: title and description; clicking acts immediately,
         unlike Choice.Card, which selects. -->
    <Style x:Key="Choice.Action" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="7" Padding="13,11"
                            Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Card2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Navigation row: label left, value right, chevron at the end.
         The whole row is clickable, as with sub-pages in Windows 11 Settings. -->
    <Style x:Key="Row.Navigate" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="7" Padding="8,7"
                            Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Card2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
    <!-- ── Tabs: accent underline, 13.5 / 600 ─────────────────────────── -->
    <Style x:Key="Tabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.Mica}"
                                BorderBrush="{DynamicResource Brush.Bd}"
                                BorderThickness="0,0,0,1"
                                Padding="14,0">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- The PART_SelectedContentHost name is required: WPF uses it to link the tab
                             content into the automation tree. Without it a screen reader sees nothing
                             but the tab headers. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tab" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Tab}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" Padding="16,11"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Progress bar: 6 px tall, radius half the height ─────────────
         Both part names are required. ProgressBar sizes the indicator itself by
         multiplying PART_Track's ActualWidth by the fraction. Without the track
         no width is ever set and the bar stays empty for any value — with no error
         in markup or output, since the binding itself works. -->
    <Style x:Key="Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bd2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <!-- Full-width track the fill is computed from. Transparent; the outer border
                                 draws the visible background. -->
                            <Rectangle x:Name="PART_Track" Fill="Transparent" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Scroll bars: thin, no arrows ───────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Brush.Fg3}" Opacity="0.45"
                                                CornerRadius="6" Margin="2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Brush.Fg3}" Opacity="0.45"
                                                        CornerRadius="6" Margin="0,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Context menu ────────────────────────────────────────────────
         Custom styling is required: the system menu is light and looks borrowed
         from another app in the dark theme. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Brush.Flyout}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,5" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bd2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── List row separator ─────────────────────────────────────────── -->
    <Style x:Key="RowSeparator" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd2}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- ── Filter chip: 31 px tall, radius 15.5 ────────────────────────
         No border on purpose. A 1 px outline on a curve shows visible steps at
         100 % scale; a fill does not. Padding is 14.7 instead of 13.6 so the chip
         keeps its size without the border. -->
    <Style x:Key="Pill" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource Brush.Chip}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="14,7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Order matters: in WPF the last matching trigger wins, so hover is
                             declared before selection. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ChipHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoftHover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Results table cell padding. Column widths live in the table itself, next
         to the column content. -->
    <Thickness x:Key="Grid.CellGap">0,0,14,0</Thickness>
    <Thickness x:Key="Grid.RowPadding">16,11</Thickness>

</ResourceDictionary>
