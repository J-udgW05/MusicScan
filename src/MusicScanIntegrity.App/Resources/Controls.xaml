<!--
    Стили элементов управления. Геометрия (радиусы, отступы, размеры) и поведение
    при наведении перенесены из UI_SPEC.md, разделы 4 и 12, и из макета
    MusicScan.dc.html. Границы всегда 1px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MusicScanIntegrity.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Кольцо фокуса ────────────────────────────────────────────────
         Собственные шаблоны кнопок отменяют системную пунктирную рамку, и
         без замены обход клавиатурой становится слепым: не видно, где ты.
         WPF рисует это только при работе с клавиатуры, мышь кольца не даёт. -->
    <Style x:Key="Focus.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2"
                               RadiusX="8" RadiusY="8"
                               Stroke="{DynamicResource Brush.Acc}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Радиусы ──────────────────────────────────────────────────────── -->
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">5</CornerRadius>
    <!-- Радиус капсулы задаётся числом, а не «999»: WPF, в отличие от CSS,
         не обрезает слишком большой CornerRadius до половины стороны, а
         пропорционально ужимает все четыре дуги — вместо капсулы с прямыми
         верхом и низом получается линза. Значение = половина высоты элемента. -->
    <CornerRadius x:Key="Radius.Pill">15.5</CornerRadius>

    <!-- ── Карточка ─────────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    </Style>

    <Style x:Key="Card.Padded" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ── Кнопки ───────────────────────────────────────────────────────── -->

    <!-- Общий шаблон: скруглённый прямоугольник с содержимым внутри.
         Выравнивание содержимого берётся у самой кнопки, а не задаётся здесь:
         почти всем нужен центр, но растянутой кнопке-ссылке — левый край, и
         жёсткий центр оставлял слева пустую полосу. -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    </Style>

    <!-- Акцентная — единственная кнопка с заливкой на панели инструментов. -->
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccFg}" />

        <!-- Кромка не совпадает с заливкой: иначе край прыгает с фона сразу
             на яркий цвет, и на скруглении это видно лесенкой. -->
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccBorder}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="Button.Outline" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="Padding" Value="13,8" />
    </Style>

    <!-- Кнопки управления проверкой стоят на утопленной поверхности. -->
    <Style x:Key="Button.Soft" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Деструктивное действие: контур, текст цветом ошибки. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="Button.DangerFilled" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Err}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Err}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="18,8" />
    </Style>

    <!-- Без рамки: «Справка», «О программе». -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="Padding" Value="12,8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bd2}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ссылка-действие внутри карточки. Единственное место, где курсор
         становится рукой: в Windows рука означает ссылку, а у кнопок,
         переключателей, вкладок и строк списка курсор остаётся стрелкой.
         Рука на всём подряд — привычка веба, и из-за неё окно выглядело
         так, будто нажимается любая его точка. -->
    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ── Поля ввода ───────────────────────────────────────────────────── -->
    <Style x:Key="TextBox.Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Tab}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <!-- Отступы задаёт сам TextBox: WPF применяет его Padding
                             к содержимому внутри PART_ContentHost. Продублировать
                             его ещё и Margin'ом — значит получить двойной отступ
                             и поле высотой 56 px вместо 38 px по макету. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                        <!-- Недоступное поле должно и выглядеть недоступным,
                             иначе непонятно, почему в него нельзя писать. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поле без собственного оформления: рамку и фон рисует то, во что оно
         вложено. Нужен явный стиль — у библиотечного TextBox своя подложка,
         которая иначе просвечивает поверх подсказки. -->
    <Style x:Key="TextBox.Bare" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="Transparent"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Выпадающий список ────────────────────────────────────────────── -->
    <Style x:Key="ComboBox.Pill" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <!-- 104 px — ширина «под самое длинное значение»; для «60 с» это поле
             с текстом посередине пустоты. Ширину задаёт содержимое, а правый
             край всё равно совпадает: списки прижаты вправо. -->
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Подложка пилюли рисуется отдельным Border, а не кнопкой:
                             у ToggleButton есть неявный стиль из библиотеки WPF-UI,
                             который перебивает размеры и схлопывает рамку. -->
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Chip}"
                                SnapsToDevicePixels="True" />

                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <!-- Шеврон только у настоящих выпадающих списков (UI_SPEC.md, раздел 12). -->
                            <controls:MsIcon Grid.Column="1" Kind="chevron-down" Size="12" Opacity="0.6"
                                             Margin="7,0,0,0" VerticalAlignment="Center"
                                             Foreground="{TemplateBinding Foreground}" />
                        </Grid>

                        <!-- Прозрачная кнопка поверх всего — только чтобы ловить клик. -->
                        <ToggleButton x:Name="Toggle"
                                      Style="{x:Null}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               VerticalOffset="4"
                               MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Flyout}"
                                    BorderBrush="{DynamicResource Brush.Bd}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Padding="4"
                                    Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
                    <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        CornerRadius="{StaticResource Radius.Chip}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bd2}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Тумблер ──────────────────────────────────────────────────────
         Отклонение от UI_SPEC.md, раздел 4, сделано сознательно: там выключенное
         состояние описано сплошной серой заливкой, а настоящий тумблер Windows 11
         в выключенном виде — контур с почти прозрачной заливкой и ползунок
         поменьше. Программа должна выглядеть как приложение Windows 11, поэтому
         взята системная геометрия: дорожка 40×20, ползунок 12×12 с отступом 4,
         плавное перемещение и увеличение ползунка при нажатии.
    -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10"
                                Background="{DynamicResource Brush.Card2}"
                                BorderBrush="{DynamicResource Brush.Fg3}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True" />

                        <!-- Ход ползунка задаётся из кода (controls:Motion.Knob).
                             Раскадровкой в шаблоне это делать нельзя: она
                             заморожена, длительность в ней на ходу не поменять,
                             а две готовые ветки на одно движение разъезжаются
                             при смене настройки анимаций. -->
                        <Border x:Name="Knob" Width="12" Height="12" CornerRadius="6"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                Background="{DynamicResource Brush.Fg2}"
                                controls:Motion.Knob="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Цвета включённого состояния: они не анимируются и от настройки не зависят. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.AccBorder}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.AccFg}" />
                        </Trigger>

                        <!-- Наведение: выключенная дорожка чуть плотнее, включённая чуть светлее. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Bd2}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Fg}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </MultiTrigger>

                        <!-- Нажатие: ползунок слегка растягивается, как в системе.
                             Именованное преобразование нельзя задать через Setter,
                             поэтому используется анимация. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="controls:Motion.Enabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.3" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="controls:Motion.Enabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.3" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Knob" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Флажок 16×16, радиус 4 ───────────────────────────────────────── -->
    <Style x:Key="CheckBox.Square" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  Data="m5.4 10.3 2.9 2.9 6.3-7"
                                  Stroke="{DynamicResource Brush.AccFg}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="None" RenderTransformOrigin="0,0">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Радиокнопка в диалоге экспорта: 15×15 с толстым кольцом ──────── -->
    <Style x:Key="Radio.Dot" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card"
                            Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.Bd}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="13,11">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="15" Height="15" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Card2}"
                                     Stroke="{DynamicResource Brush.Bd}" StrokeThickness="1" />
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Dot" Property="StrokeThickness" Value="4" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Card}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Выбор из нескольких равных вариантов (тема оформления) ───────── -->
    <Style x:Key="ThemeChoice" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="8" Padding="11"
                            Background="{DynamicResource Brush.Card2}"
                            BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Чип формата: включён — обычная плашка, выключен — приглушённая.
         Состояние читается не только цветом: у выключенного текст зачёркнут. -->
    <Style x:Key="Chip.Format" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.Chip}"
                            Background="{DynamicResource Brush.Card2}"
                            BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                            Padding="9,5" SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{DynamicResource Brush.Fg2}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Зона перетаскивания ──────────────────────────────────────────
         Это не картинка, а рабочая область: по ней можно и щёлкнуть, поэтому
         под курсором она подсвечивается акцентом, а курсор становится рукой.
         Пунктир рисует Rectangle: Border в WPF пунктирную рамку не умеет. -->
    <Style x:Key="Drop.Zone" TargetType="Button">
        <Setter Property="Height" Value="132" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Frame" RadiusX="8" RadiusY="8" StrokeThickness="1.5"
                                   StrokeDashArray="4 3"
                                   Stroke="{DynamicResource Brush.Bd}"
                                   Fill="{DynamicResource Brush.Card2}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource Brush.Card2}" />
                        </Trigger>
                        <!-- Папку тянут к окну: зона подсвечивается вместе с ним. -->
                        <DataTrigger Binding="{Binding IsDragActive}" Value="True">
                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource Brush.AccSoft}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Карточка-действие: заголовок и пояснение, нажатие сразу
         выполняет действие (в отличие от Choice.Card, где идёт выбор). -->
    <Style x:Key="Choice.Action" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="7" Padding="13,11"
                            Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Card2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Строка-переход: подпись слева, значение справа, шеврон в конце.
         Нажимается вся строка целиком — так открываются подстраницы в
         параметрах Windows 11. Раньше нажималось только значение, набранное
         мелким серым моноширинным шрифтом, и настройка выглядела справкой. -->
    <Style x:Key="Row.Navigate" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="7" Padding="8,7"
                            Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Card2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
    <!-- ── Вкладки: подчёркивание акцентом, 13,5 / 600 ──────────────────── -->
    <Style x:Key="Tabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.Mica}"
                                BorderBrush="{DynamicResource Brush.Bd}"
                                BorderThickness="0,0,0,1"
                                Padding="14,0">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- Имя PART_SelectedContentHost обязательно: по нему WPF
                             связывает содержимое вкладки с деревом автоматизации.
                             Без него экранный диктор не видит вообще ничего,
                             кроме заголовков вкладок. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tab" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Tab}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" Padding="16,11"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Acc}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Полоса прогресса: высота 6, радиус — половина высоты ──────────────
         Оба имени обязательны. Ширину заполненной части ProgressBar считает
         сам: берёт ActualWidth элемента PART_Track, умножает на долю и
         присваивает PART_Indicator. Без дорожки умножать не на что — ширина
         не задаётся вовсе, и полоса остаётся пустой при любом значении.
         Ошибку не видно ни в разметке, ни в журнале: привязка исправна,
         значение доходит, а полоса пуста. -->
    <Style x:Key="Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bd2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Acc}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <!-- Дорожка во всю ширину: по ней и считается заполнение.
                                 Прозрачная — видимый фон рисует внешняя рамка. -->
                            <Rectangle x:Name="PART_Track" Fill="Transparent" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Полосы прокрутки: тонкие, без стрелок ────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Brush.Fg3}" Opacity="0.45"
                                                CornerRadius="6" Margin="2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Brush.Fg3}" Opacity="0.45"
                                                        CornerRadius="6" Margin="0,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Контекстное меню ─────────────────────────────────────────────
         Своё оформление обязательно: системное меню светлое и в тёмной теме
         выглядит вставкой из другой программы. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Brush.Flyout}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,5" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bd2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Разделитель строки списка ────────────────────────────────────── -->
    <Style x:Key="RowSeparator" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd2}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- ── Пилюля-фильтр: высота 31, радиус 15,5 ──────────────────────────
         Рамки нет намеренно. Контур в одну точку на скруглении даёт заметные
         ступеньки: сглаживание работает, но на масштабе 100 % точка полной
         яркости при движении по дуге перескакивает на соседний ряд. У заливки
         этой беды нет — дуга закрашена целиком. Отступы 14,7 против прежних
         13,6: рамка занимала точку с каждой стороны, и без неё пилюля иначе
         стала бы на две точки меньше. -->
    <Style x:Key="Pill" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource Brush.Chip}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="14,7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Порядок важен: в WPF побеждает последний сработавший
                             триггер, поэтому наведение объявлено раньше выбора. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ChipHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoft}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccSoftHover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Отступы ячеек таблицы результатов. Ширины колонок заданы в самой
         таблице: они там читаются вместе с содержимым колонки. -->
    <Thickness x:Key="Grid.CellGap">0,0,14,0</Thickness>
    <Thickness x:Key="Grid.RowPadding">16,11</Thickness>

</ResourceDictionary>
