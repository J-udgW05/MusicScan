<!--
    Main window: title bar, toolbar, tabs and status bar.

    Opens at 880 px, which is also the minimum width: at 880 the results filter
    row already wraps and the table reaches the limit of readability. Nothing
    larger is needed by default since the layout stretches. The height fits the scan
    tab without leaving empty space under the cards; everything taller scrolls. Sizes
    here are design values; UiScale enlarges the window and its content at startup.
-->
<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:svc="clr-namespace:MusicScanIntegrity.App.Services"
                 xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
                 xmlns:v="clr-namespace:MusicScanIntegrity.App.Views"
                 xmlns:vm="clr-namespace:MusicScanIntegrity.App.ViewModels"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Music Scan Integrity"
                 Width="880" Height="724" MinWidth="880" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}"
                 Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
                 Closing="OnClosing">

    <ui:FluentWindow.InputBindings>
        <!-- Keyboard shortcuts listed in the help window. -->
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding PickFolderCommand}" />
        <KeyBinding Key="F5" Command="{Binding StartCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RescanCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Title bar: 44 px, title on the left ───────────────────────
             No app mark here on purpose: the taskbar and Alt+Tab already show it. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.ChromeLine}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="44" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="True" ShowMinimize="True" ShowClose="True">
                <ui:TitleBar.Header>
                    <TextBlock Text="Music Scan Integrity"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <!-- ── Toolbar ───────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.ChromeLine}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Accent}"
                        Command="{Binding PickFolderCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="{svc:T Ui_PickFolder}"
                        ToolTip="{svc:T Main_PickFolder_Tip}">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="folder" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{svc:T Ui_PickFolder}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Rescan the same folder: its contents may have changed, and picking the
                     path again is pointless. -->
                <!-- No export button here: export lives on the report tab, next to what gets
                     saved, and on Ctrl+S. -->
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Outline}"
                        Command="{Binding RescanCommand}"
                        AutomationProperties.Name="{svc:T Ui_Rescan}"
                        ToolTip="{svc:T Main_Rescan_Tip}">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="retry" Size="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{svc:T Ui_Rescan}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}"
                        Command="{Binding ShowAboutCommand}"
                        AutomationProperties.Name="{svc:T Ui_About}">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="info" Size="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{svc:T Ui_About}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}"
                        Command="{Binding ShowHelpCommand}"
                        AutomationProperties.Name="{svc:T Ui_Help}">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="help" Size="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{svc:T Ui_Help}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Settings sit with Help and About rather than among the work actions. -->
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}"
                        Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="{svc:T Ui_Settings}"
                        ToolTip="{svc:T Main_Settings_Tip}">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="settings" Size="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{svc:T Ui_Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ── Tabs ──────────────────────────────────────────────────────── -->
        <!-- Clip to bounds: the entrance animation shifts content with a transform,
             which is unclipped and would draw over the toolbar. -->
        <TabControl Grid.Row="2" Style="{StaticResource Tabs}"
                    ClipToBounds="True"
                    SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">

            <TabItem Style="{StaticResource Tab}" Header="{svc:T Ui_Scan}">
                <v:ScanView />
            </TabItem>

            <TabItem Style="{StaticResource Tab}" AutomationProperties.Name="{svc:T Ui_Results}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{svc:T Ui_Results}" />
                        <TextBlock Text="{Binding Results.TotalLabel}" Margin="6,0,0,0"
                                   Opacity="0.6" FontWeight="{StaticResource Weight.Medium}"
                                   Visibility="{Binding Results.TotalCount, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </TabItem.Header>
                <v:ResultsView />
            </TabItem>

            <TabItem Style="{StaticResource Tab}" Header="{svc:T Ui_Report}">
                <v:ReportView />
            </TabItem>

        </TabControl>

        <!-- ── Settings screen: replaces the tabs, with a back arrow ────────
             The tabs are hidden rather than covered: with Mica the page background
             is transparent and would cover nothing. -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Bg}" ClipToBounds="True"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Brush.Chrome}"
                        BorderBrush="{DynamicResource Brush.ChromeLine}" BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Ghost}" Padding="8,6"
                                AutomationProperties.Name="{svc:T Ui_Back}"
                                ToolTip="{svc:T Main_Back_Tip}"
                                Command="{Binding CloseSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <!-- The icon set has no back arrow, so the list chevron is rotated to point
                                     left. -->
                                <c:MsIcon Kind="chevron-down" Size="16" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                    <c:MsIcon.RenderTransform>
                                        <RotateTransform Angle="90" />
                                    </c:MsIcon.RenderTransform>
                                </c:MsIcon>
                                <TextBlock Text="{svc:T Ui_Back}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{svc:T Ui_Settings}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource Size.CardTitle}"
                                   FontWeight="{StaticResource Weight.Semi}" />
                    </StackPanel>
                </Border>

                <v:SettingsView Grid.Row="1" />
            </Grid>
        </Border>

        <!-- ── Status bar ────────────────────────────────────────────────── -->
        <!-- The setting switches the bar on; an enabled bar still hides while empty. -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.ChromeLine}" BorderThickness="0,1,0,0"
                Padding="16,9">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource StatusBarVisibility}">
                    <Binding Path="Settings.ShowStatusBar" />
                    <Binding Path="StatusCounts" />
                    <Binding Path="FolderPath" />
                </MultiBinding>
            </Border.Visibility>
            <!-- The path goes last and takes the remaining width: it is the longest item
                 and should be trimmed last. -->
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusCounts}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Brush.Fg2}" />

                <TextBlock DockPanel.Dock="Left" Text="|" Margin="14,0"
                           Foreground="{DynamicResource Brush.Bd}" VerticalAlignment="Center">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource AllNotEmptyToVisibility}">
                            <Binding Path="StatusCounts" />
                            <Binding Path="FolderPath" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>

                <TextBlock Text="{Binding FolderPath}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Brush.Fg2}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FolderPath}" />
            </DockPanel>
        </Border>

        <!-- Window highlight while a folder is dragged over it. -->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource Brush.AccSoft}" Opacity="0.92"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:MsIcon Kind="folder" Size="36" StrokeWeight="1.5" HorizontalAlignment="Center"
                          Foreground="{DynamicResource Brush.Acc}" />
                <TextBlock Text="{svc:T Main_DropHint}"
                           Margin="0,14,0,0" FontSize="15"
                           FontWeight="{StaticResource Weight.Semi}"
                           Foreground="{DynamicResource Brush.Acc}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
