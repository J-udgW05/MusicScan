<UserControl x:Class="MusicScanIntegrity.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
             xmlns:vm="clr-namespace:MusicScanIntegrity.App.ViewModels"
             xmlns:core="clr-namespace:MusicScanIntegrity.Core.Settings;assembly=MusicScanIntegrity.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Background="{DynamicResource Brush.Bg}"
             c:Motion.Entrance="True">

    <UserControl.Resources>
        <!-- Строка настройки: подпись слева, значение справа с min-width 104
             (UI_SPEC.md, раздел 12) — правый край выровнен по всему разделу. -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd2}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd2}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <ObjectDataProvider x:Key="Themes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:AppTheme" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <!-- Горизонтальная прокрутка отключена: колонки тянутся по ширине,
         а «Auto» по умолчанию выдавала внизу полосу на ровном месте. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="22">
        <Grid DataContext="{Binding Settings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══ Левая колонка ═════════════════════════════════════════ -->
            <StackPanel Grid.Row="0" Grid.Column="0">

                <!-- Внешний вид -->
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Text.BlockTitle}" Text="Внешний вид" />
                        </Border>

                        <StackPanel Margin="18,16">
                            <TextBlock Style="{StaticResource Text.Base}" Text="Тема оформления" Margin="0,0,0,10" />

                            <UniformGrid Rows="1" Columns="3">
                                <RadioButton GroupName="Theme" Margin="0,0,4,0"
                                             Style="{StaticResource ThemeChoice}" Content="Как в системе"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter={x:Static core:AppTheme.System}}" />
                                <RadioButton GroupName="Theme" Margin="4,0"
                                             Style="{StaticResource ThemeChoice}" Content="Светлая"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter={x:Static core:AppTheme.Light}}" />
                                <RadioButton GroupName="Theme" Margin="4,0,0,0"
                                             Style="{StaticResource ThemeChoice}" Content="Тёмная"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter={x:Static core:AppTheme.Dark}}" />
                            </UniformGrid>

                            <TextBlock Style="{StaticResource Text.Base}" Text="Цвета статусов" Margin="0,18,0,2" />

                            <ItemsControl ItemsSource="{Binding StatusColors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StatusColorRow}">
                                        <Border BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
                                            <!-- Нажимается вся строка: образец цвета и есть то место,
                                                 куда тянется рука, а раньше он был просто картинкой. -->
                                            <Button Style="{StaticResource Row.Navigate}"
                                                    AutomationProperties.Name="{Binding Label, StringFormat=Цвет статуса {0}}"
                                                    ToolTip="Выбрать цвет"
                                                    Command="{Binding DataContext.PickStatusColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <DockPanel LastChildFill="False">
                                                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6"
                                                            BorderBrush="#22000000" BorderThickness="1"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding EffectiveHex, Converter={StaticResource HexToBrush}}" />

                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Base}"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.Fg2}"
                                                               Text="{Binding Label}" />

                                                    <!-- Шеврон как в параметрах Windows: строка открывает окно выбора. -->
                                                    <c:MsIcon DockPanel.Dock="Right" Kind="chevron-down" Size="14"
                                                              Margin="8,0,0,0" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Brush.Fg3}"
                                                              RenderTransformOrigin="0.5,0.5">
                                                        <c:MsIcon.RenderTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </c:MsIcon.RenderTransform>
                                                    </c:MsIcon>

                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}"
                                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                                            Content="Сбросить"
                                                            ToolTip="Вернуть цвет темы"
                                                            AutomationProperties.Name="{Binding Label, StringFormat=Вернуть цвет темы: {0}}"
                                                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.ResetStatusColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />

                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Tertiary}"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               Text="{Binding EffectiveHex}" />
                                                </DockPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel LastChildFill="False" Margin="0,14,0,0">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Плотность списка результатов" />
                                </StackPanel>
                                <ComboBox DockPanel.Dock="Right" Style="{StaticResource ComboBox.Pill}"
                                          MinWidth="104" AutomationProperties.Name="Плотность списка"
                                          SelectedItem="{Binding ListDensity}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}">
                                    <core:ListDensity>Normal</core:ListDensity>
                                    <core:ListDensity>Compact</core:ListDensity>
                                </ComboBox>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,14,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Base}"
                                           Text="Показывать полные пути к файлам" VerticalAlignment="Center" />
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Показывать полные пути к файлам"
                                          IsChecked="{Binding ShowFullPaths}" />
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Base}"
                                           Text="Одинаковая ширина букв в путях" VerticalAlignment="Center" />
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Моноширинный шрифт для путей"
                                          IsChecked="{Binding MonospacePaths}" />
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Base}"
                                           Text="Показывать строку состояния внизу" VerticalAlignment="Center" />
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Показывать строку состояния внизу"
                                          IsChecked="{Binding ShowStatusBar}" />
                            </DockPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Подложка Mica" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" Text="{Binding MicaNote}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding IsMicaSupported}"
                                          AutomationProperties.Name="Подложка Mica"
                                          IsChecked="{Binding MicaEffect}" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Анимации" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="плавное появление вкладок и переключателей" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Анимации"
                                          IsChecked="{Binding Animations}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Форматы -->
                <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.BlockTitle}" Text="Форматы" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Tertiary}"
                                           VerticalAlignment="Center" Text="{Binding FormatsSummary}" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="18,14">
                            <ItemsControl ItemsSource="{Binding Formats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FormatChip}">
                                        <ToggleButton Style="{StaticResource Chip.Format}" Margin="0,0,6,6"
                                                      IsChecked="{Binding Enabled}"
                                                      AutomationProperties.Name="{Binding Extension}"
                                                      ToolTip="Нажмите, чтобы включить или выключить формат"
                                                      Content="{Binding Extension}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,1,0,0"
                                    Margin="0,10,0,0" Padding="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource Text.Base}" Text="Проверять образы дисков ISO (SACD)" />
                                        <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                                   Text="Экспериментально, работает не всегда" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                              AutomationProperties.Name="Проверять образы дисков ISO (SACD)"
                                              IsChecked="{Binding EnableIsoSacd}" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Base}" Text="Дополнительные расширения файлов" />
                                <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,6"
                                           Text="Через запятую, например: .mpc, .tta" />
                                <TextBox Style="{StaticResource TextBox.Field}"
                                         Text="{Binding CustomExtensions, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Занятые файлы -->
                <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Text.BlockTitle}" Text="Занятые файлы" />
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Что делать с занятым файлом" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBox.Pill}"
                                          MinWidth="140" SelectedItem="{Binding LockedFileAction}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}">
                                    <core:LockedFileAction>Ask</core:LockedFileAction>
                                    <core:LockedFileAction>Skip</core:LockedFileAction>
                                    <core:LockedFileAction>Wait</core:LockedFileAction>
                                    <core:LockedFileAction>TempCopy</core:LockedFileAction>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Сколько ждать освобождения файла, секунд" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="перед повторной попыткой" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource TextBox.Field}"
                                         Width="68" Padding="10,5" TextAlignment="Center"
                                         Text="{Binding LockedWaitSeconds}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Сколько раз повторить попытку" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="затем файл помечается пропущенным" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource TextBox.Field}"
                                         Width="68" Padding="10,5" TextAlignment="Center"
                                         Text="{Binding LockedRetryCount}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Узнавать, какая программа держит файл" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Определять программу-владельца"
                                          IsChecked="{Binding DetectOwnerProcess}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Применять ответ ко всем занятым файлам" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="флажок в самом вопросе" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Применять ответ ко всем занятым файлам"
                                          IsChecked="{Binding AllowApplyToAllLocked}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Предлагать закрыть эту программу" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="потенциально опасно" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Предлагать закрыть владельца"
                                          IsChecked="{Binding OfferCloseOwner}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Что ещё искать: проверки, которые смотрят не на целость
                     файла, а на то, как он звучит, и на коллекцию целиком.
                     Отдельной карточкой ещё и потому, что без неё правая
                     колонка вырастала вдвое выше левой. -->
                <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Text.BlockTitle}" Text="Что ещё искать" />
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Разбирать альбомы и искать повторы" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="пропуски в нумерации, разнобой форматов в папке, отсутствие обложки, один и тот же трек в разных местах — попадают на вкладку «Отчёт»" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Разбирать альбомы и искать повторы"
                                          IsChecked="{Binding InspectCollection}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Замечать тишину и провалы" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="файл читается, но звучит тишиной" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Замечать тишину и провалы"
                                          IsChecked="{Binding DetectSilence}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Искать перекодированные файлы" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Искать перекодированные файлы"
                                          IsChecked="{Binding DetectTranscode}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Замечать перегрузку громкости и смещение нуля" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="выключено намеренно: у современных мастерингов звук упирается в предел шкалы сплошь и рядом" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Замечать перегрузку громкости и смещение нуля"
                                          IsChecked="{Binding DetectClipping}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2">

                <!-- Проверка -->
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Text.BlockTitle}" Text="Проверка" />
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Заходить в подпапки" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Рекурсивный обход подпапок"
                                          IsChecked="{Binding Recursive}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Проверять теги" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Проверка метаданных"
                                          IsChecked="{Binding CheckMetadata}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Проверять плейлисты" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="искать отсутствующие пути внутри M3U, PLS, CUE" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Проверять плейлисты"
                                          IsChecked="{Binding CheckPlaylists}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Сколько читать из каждого файла" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="выборочно — конец и три места в середине; целиком надёжнее, но на большой коллекции это часы" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBox.Pill}"
                                          MinWidth="128" VerticalAlignment="Center"
                                          AutomationProperties.Name="Сколько читать из каждого файла"
                                          SelectedItem="{Binding CheckDepth}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}">
                                    <core:CheckDepth>Quick</core:CheckDepth>
                                    <core:CheckDepth>Sampled</core:CheckDepth>
                                    <core:CheckDepth>Full</core:CheckDepth>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Проверять контрольные суммы в файле" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="FLAC и Ogg сверяются по своим суммам, MP3 и MP4 — по структуре" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Проверять контрольные суммы в файле"
                                          IsChecked="{Binding VerifyContainerIntegrity}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Щадить жёсткий диск" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="жёсткий диск читает быстрее, когда его не дёргают: восемь файлов разом заставляют головку метаться, и проверка идёт медленнее, чем в два" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Щадить жёсткий диск"
                                          IsChecked="{Binding RespectDriveType}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource Text.Base}" Text="Следить за порчей файлов" />
                                        <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="запоминает отпечаток каждого файла и находит тихую порчу: содержимое изменилось, а размер и дата прежние. Первая проверка при этом читает каждый файл целиком" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Следить за порчей файлов"
                                              IsChecked="{Binding TrackChanges}" />
                                </Grid>

                                <DockPanel LastChildFill="False" Margin="0,10,0,0"
                                           Visibility="{Binding TrackChanges, Converter={StaticResource BoolToVisibility}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}"
                                            Padding="12,6" Content="Очистить историю"
                                            AutomationProperties.Name="Очистить историю"
                                            Command="{Binding ClearHistoryCommand}" />
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Tertiary}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                                               Text="{Binding HistoryNote}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Сверять расширение с содержимым" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="MP3, который на деле FLAC, помечается предупреждением" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Сверять расширение с содержимым"
                                          IsChecked="{Binding VerifyExtension}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Большим считается файл от" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBox.Pill}"
                                          ItemsSource="{x:Static vm:SettingsViewModel.ThresholdOptions}"
                                          SelectedItem="{Binding Threshold}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Ждать один файл не дольше" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="дальше — статус «подозрительный»" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBox.Pill}"
                                          ItemsSource="{x:Static vm:SettingsViewModel.TimeoutOptions}"
                                          SelectedItem="{Binding Timeout}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Подбирать нагрузку автоматически" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="по числу ядер, не больше 8" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Подбирать нагрузку автоматически"
                                          IsChecked="{Binding AutoParallelism}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Сколько файлов проверять разом" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="работает, когда подбор выключен" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource TextBox.Field}"
                                         Width="68" Padding="10,5" TextAlignment="Center"
                                         IsEnabled="{Binding AutoParallelism, Converter={StaticResource InvertBool}}"
                                         Text="{Binding ManualParallelism}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Предупреждать о больших файлах" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                               Text="до начала их проверки" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Предупреждать о больших файлах"
                                          IsChecked="{Binding WarnAboutLargeFiles}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Общие и отчёты -->
                <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource Text.BlockTitle}" Text="Общие и отчёты" />
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Запоминать последнюю папку" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Запоминать последнюю папку"
                                          IsChecked="{Binding RememberLastFolder}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Предлагать начать сразу после выбора папки" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Предлагать начать сразу после выбора папки"
                                          IsChecked="{Binding OfferStartAfterFolderSelected}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Показывать подсказку при первом запуске" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Показывать подсказку при первом запуске"
                                          IsChecked="{Binding ShowFirstRunTip}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Звук по завершении проверки" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Звук по завершении проверки"
                                          IsChecked="{Binding SoundOnFinish}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Формат отчёта по умолчанию" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBox.Pill}"
                                          SelectedItem="{Binding DefaultReportFormat}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}">
                                    <core:ReportFormat>Html</core:ReportFormat>
                                    <core:ReportFormat>Csv</core:ReportFormat>
                                    <core:ReportFormat>Text</core:ReportFormat>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Папка для отчётов" />
                                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding ReportsFolder, TargetNullValue='Документы'}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Outline}"
                                        MinWidth="104" Padding="10,5" Content="Изменить"
                                        FontSize="{StaticResource Size.Secondary}"
                                        Background="{DynamicResource Brush.Card2}"
                                        Command="{Binding PickReportsFolderCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Включать в отчёт файлы без замечаний" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Включать в отчёт целые файлы"
                                          IsChecked="{Binding IncludeOkFilesInReport}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Text.Base}" Text="Открывать отчёт после сохранения" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                          AutomationProperties.Name="Открывать отчёт после сохранения"
                                          IsChecked="{Binding OpenReportAfterSave}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ══ Файл настроек и сброс: общий для обеих колонок ══════════
                 Раньше здесь лежали четыре разнородные вещи подряд: фраза
                 про мгновенное применение, красная кнопка у правого края,
                 ссылка «Открыть папку» и голый путь под ней. Теперь слева
                 один блок — подпись и сам путь, который и есть ссылка,
                 справа кнопка сброса по центру всей строки. -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}"
                    Padding="18,15" Margin="0,18,0,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}"
                            VerticalAlignment="Center" Margin="18,0,0,0"
                            MinWidth="132" Padding="15,9"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Err}"
                            Foreground="{DynamicResource Brush.Err}"
                            FontWeight="{StaticResource Weight.Semi}"
                            Content="Сбросить всё"
                            ToolTip="Вернуть все настройки к значениям по умолчанию"
                            AutomationProperties.Name="Сбросить все настройки"
                            Command="{Binding ResetAllCommand}" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Eyebrow}" Text="ФАЙЛ НАСТРОЕК" />

                        <!-- Путь и есть ссылка: отдельная строка «Открыть папку»
                             рядом с тем же путём была бы повтором. -->
                        <!-- Кнопка тянется во всю ширину, а путь лежит в колонке
                             со звёздочкой: только так TextTrimming знает, где
                             обрезать. Прижатая влево кнопка мерилась без границ,
                             многоточие не появлялось, и длинный путь просто
                             уходил под край карточки. -->
                        <Button Style="{StaticResource Button.Link}" Margin="0,7,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                ToolTip="Открыть папку с файлом настроек"
                                AutomationProperties.Name="Открыть папку с файлом настроек"
                                Command="{Binding OpenSettingsFolderCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <c:MsIcon Grid.Column="0" Kind="open-external" Size="14"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SettingsFilePath}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource Size.Mono}"
                                           FontWeight="{StaticResource Weight.Body}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
