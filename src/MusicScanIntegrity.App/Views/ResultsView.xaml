<UserControl x:Class="MusicScanIntegrity.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:MusicScanIntegrity.App.Services"
             xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
             xmlns:vm="clr-namespace:MusicScanIntegrity.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Background="{DynamicResource Brush.Bg}"
             c:Motion.Entrance="True">

    <UserControl.Resources>
        <!-- Table column widths: 24 · 2.15* · 3* · 72 · 92 · 148, 14 px gap. Header
             and rows share the same layout, so the columns always line up. -->
        <GridLength x:Key="Col.Icon">24</GridLength>
        <GridLength x:Key="Col.Format">72</GridLength>
        <GridLength x:Key="Col.Size">92</GridLength>
        <GridLength x:Key="Col.Status">148</GridLength>

        <!-- Column header is a button: click sorts, clicking again reverses. -->
        <Style x:Key="Column.Header" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg3}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Direction arrow: down means descending. -->
        <Style x:Key="Sort.Arrow" TargetType="c:MsIcon">
            <Setter Property="Kind" Value="sort" />
            <Setter Property="Size" Value="12" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg2}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SortAscending}" Value="False">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleY="-1" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status colours come from triggers with DynamicResource rather than a
             converter: a converter hands out a brush once and is not re-evaluated on a
             theme change, which left the details card dark after switching to light.
             The icon and text inherit their colour through TextElement.Foreground. -->
        <Style x:Key="Status.Square" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource Brush.Card2}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Fg2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource Brush.OkBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Corrupted">
                    <Setter Property="Background" Value="{DynamicResource Brush.ErrBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Err}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Background" Value="{DynamicResource Brush.SkipBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Skip}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Status.Pill" TargetType="Border" BasedOn="{StaticResource Status.Square}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="CornerRadius" Value="11.5" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The details card follows the selected row; with nothing selected there is
             no status and the card stays neutral. -->
        <Style x:Key="Details.Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bd}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.Status}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource Brush.OkBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected.Status}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected.Status}" Value="Corrupted">
                    <Setter Property="Background" Value="{DynamicResource Brush.ErrBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected.Status}" Value="Skipped">
                    <Setter Property="Background" Value="{DynamicResource Brush.SkipBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22" DataContext="{Binding Results}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Search and filters ════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <!-- The chip column stretches, not the search box. A search box wider than
                 240 px gains nothing, while the chips need room: only in a stretching column
                 do they know their width and wrap. With Auto the WrapPanel measured against
                 infinite width, never wrapped and pushed past the window edge. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search by file name -->
            <Border Grid.Column="0" VerticalAlignment="Top"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <c:MsIcon Grid.Column="0" Kind="search" Size="16" VerticalAlignment="Center"
                              Foreground="{DynamicResource Brush.Fg3}" />

                    <Grid Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock Text="{svc:T Results_Search}" VerticalAlignment="Center"
                                   FontSize="{StaticResource Size.Body}"
                                   Foreground="{DynamicResource Brush.Fg3}"
                                   Visibility="{Binding SearchText, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                        <TextBox Style="{StaticResource TextBox.Bare}" Margin="0,0,22,0"
                                 AutomationProperties.Name="{svc:T Results_Search}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

                        <!-- The clear button appears only when there is something to clear. -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource Button.Ghost}" Padding="3"
                                AutomationProperties.Name="{svc:T Results_ClearSearch}"
                                ToolTip="{svc:T Results_ClearSearch}"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding ClearSearchCommand}">
                            <c:MsIcon Kind="mark-broken" Size="13" StrokeWeight="1.8"
                                      Foreground="{DynamicResource Brush.Fg3}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Filter chips with per-status counts; they wrap on a narrow window instead
                 of running off the edge. -->
            <ItemsControl Grid.Column="1" Margin="10,0,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ToggleButton Style="{StaticResource Pill}" Margin="0,0,8,6"
                              IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                              Command="{Binding FilterByStatusCommand}" CommandParameter="All">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{svc:T Ui_All}" Foreground="{DynamicResource Brush.Acc}" />
                        <TextBlock Text="{Binding TotalCount, Converter={StaticResource NumberFormat}}"
                                   Margin="7,0,0,0" Opacity="0.62"
                                   FontWeight="{StaticResource Weight.Medium}"
                                   Foreground="{DynamicResource Brush.Acc}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource Pill}" Margin="0,0,8,6"
                              IsChecked="{Binding IsOkSelected, Mode=OneWay}"
                              Command="{Binding FilterByStatusCommand}" CommandParameter="Ok">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="mark-ok" Size="13" StrokeWeight="1.9" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.Ok}" />
                        <TextBlock Text="{svc:T Ui_Ok}" Margin="7,0,0,0" Foreground="{DynamicResource Brush.Ok}" />
                        <TextBlock Text="{Binding OkCount, Converter={StaticResource NumberFormat}}"
                                   Margin="7,0,0,0" Opacity="0.62"
                                   FontWeight="{StaticResource Weight.Medium}"
                                   Foreground="{DynamicResource Brush.Ok}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource Pill}" Margin="0,0,8,6"
                              IsChecked="{Binding IsCorruptedSelected, Mode=OneWay}"
                              Command="{Binding FilterByStatusCommand}" CommandParameter="Corrupted">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="mark-broken" Size="13" StrokeWeight="1.9" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.Err}" />
                        <TextBlock Text="{svc:T Ui_Corrupted}" Margin="7,0,0,0" Foreground="{DynamicResource Brush.Err}" />
                        <TextBlock Text="{Binding CorruptedCount, Converter={StaticResource NumberFormat}}"
                                   Margin="7,0,0,0" Opacity="0.62"
                                   FontWeight="{StaticResource Weight.Medium}"
                                   Foreground="{DynamicResource Brush.Err}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource Pill}" Margin="0,0,8,6"
                              IsChecked="{Binding IsWarningSelected, Mode=OneWay}"
                              Command="{Binding FilterByStatusCommand}" CommandParameter="Warning">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="mark-warning" Size="13" StrokeWeight="1.9" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.Warn}" />
                        <TextBlock Text="{svc:T Ui_Warnings}" Margin="7,0,0,0" Foreground="{DynamicResource Brush.Warn}" />
                        <TextBlock Text="{Binding WarningCount, Converter={StaticResource NumberFormat}}"
                                   Margin="7,0,0,0" Opacity="0.62"
                                   FontWeight="{StaticResource Weight.Medium}"
                                   Foreground="{DynamicResource Brush.Warn}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource Pill}" Margin="0,0,8,6"
                              IsChecked="{Binding IsSkippedSelected, Mode=OneWay}"
                              Command="{Binding FilterByStatusCommand}" CommandParameter="Skipped">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="mark-skipped" Size="13" StrokeWeight="1.9" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.Skip}" />
                        <TextBlock Text="{svc:T Ui_Skipped}" Margin="7,0,0,0" Foreground="{DynamicResource Brush.Skip}" />
                        <TextBlock Text="{Binding SkippedCount, Converter={StaticResource NumberFormat}}"
                                   Margin="7,0,0,0" Opacity="0.62"
                                   FontWeight="{StaticResource Weight.Medium}"
                                   Foreground="{DynamicResource Brush.Skip}" />
                    </StackPanel>
                </ToggleButton>
            </ItemsControl>

            <ComboBox Grid.Column="2" Style="{StaticResource ComboBox.Pill}"
                      VerticalAlignment="Top" Padding="12,8" MinWidth="126"
                      ItemsSource="{Binding Formats}" SelectedItem="{Binding FormatFilter}"
                      ItemTemplate="{StaticResource EnumItemTemplate}" />
        </Grid>

        <!-- ══ Table ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Card2}"
                        BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="0,0,0,1"
                        Padding="{StaticResource Grid.RowPadding}">
                    <Grid Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.Icon}" />
                            <ColumnDefinition Width="2.15*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="{StaticResource Col.Format}" />
                            <ColumnDefinition Width="{StaticResource Col.Size}" />
                            <ColumnDefinition Width="{StaticResource Col.Status}" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Style="{StaticResource Column.Header}"
                                Margin="{StaticResource Grid.CellGap}"
                                AutomationProperties.Name="{svc:T Results_SortName}"
                                Command="{Binding SortByCommand}" CommandParameter="Name">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Results_Col_Name}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <c:MsIcon Style="{StaticResource Sort.Arrow}"
                                          Visibility="{Binding IsSortedByName, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource Column.Header}"
                                Margin="{StaticResource Grid.CellGap}"
                                AutomationProperties.Name="{svc:T Results_SortPath}"
                                Command="{Binding SortByCommand}" CommandParameter="Path">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Results_Col_Path}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <c:MsIcon Style="{StaticResource Sort.Arrow}"
                                          Visibility="{Binding IsSortedByPath, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource Column.Header}"
                                Margin="{StaticResource Grid.CellGap}"
                                AutomationProperties.Name="{svc:T Results_SortFormat}"
                                Command="{Binding SortByCommand}" CommandParameter="Format">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Results_Col_Format}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <c:MsIcon Style="{StaticResource Sort.Arrow}"
                                          Visibility="{Binding IsSortedByFormat, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource Column.Header}"
                                Margin="{StaticResource Grid.CellGap}"
                                HorizontalContentAlignment="Right"
                                AutomationProperties.Name="{svc:T Results_SortSize}"
                                Command="{Binding SortByCommand}" CommandParameter="Size">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Results_Col_Size}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <c:MsIcon Style="{StaticResource Sort.Arrow}"
                                          Visibility="{Binding IsSortedBySize, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="5" Style="{StaticResource Column.Header}"
                                AutomationProperties.Name="{svc:T Results_SortStatus}"
                                Command="{Binding SortByCommand}" CommandParameter="Status">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Results_Col_Status}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <c:MsIcon Style="{StaticResource Sort.Arrow}"
                                          Visibility="{Binding IsSortedByStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Rows. Virtualisation is mandatory: collections run to hundreds of
                     thousands of files. -->
                <!-- Tag holds the window view model. The context menu lives outside the
                     visual tree and reaches data only through PlacementTarget, while the list's
                     own DataContext is the tab view model, which has no commands. -->
                <ListBox x:Name="Rows" Grid.Row="1"
                         ItemsSource="{Binding View}"
                         SelectedItem="{Binding Selected}"
                         SelectionMode="Extended"
                         Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         PreviewMouseRightButtonDown="OnRowRightClick"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         MouseDoubleClick="OnRowDoubleClick">
                    <!-- The menu hangs on the list rather than the row: only then do commands
                         receive the full selection (PlacementTarget.SelectedItems). -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{svc:T Results_OpenFile}"
                                      Command="{Binding PlacementTarget.Tag.OpenResultCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{svc:T Results_OpenFileFolder}"
                                      Command="{Binding PlacementTarget.Tag.RevealResultCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{svc:T Results_CopyPath}"
                                      Command="{Binding PlacementTarget.Tag.CopyResultPathsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- The container supplies the accessible name, not the template content;
                                 otherwise a screen reader announces the view model class name instead of
                                 the file name and status. -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding DetailsTitle}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="Transparent"
                                                BorderBrush="{DynamicResource Brush.Bd2}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{DynamicResource Brush.Card2}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{DynamicResource Brush.AccSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileResultViewModel}">
                            <Grid Margin="{Binding DataContext.Settings.RowPadding, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Col.Icon}" />
                                    <ColumnDefinition Width="2.15*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="{StaticResource Col.Format}" />
                                    <ColumnDefinition Width="{StaticResource Col.Size}" />
                                    <ColumnDefinition Width="{StaticResource Col.Status}" />
                                </Grid.ColumnDefinitions>

                                <!-- Status icon: 14 px outline inside a 20×20 coloured square, radius 5. -->
                                <Border Grid.Column="0" Style="{StaticResource Status.Square}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <c:MsIcon Size="14" StrokeWeight="1.8"
                                              Kind="{Binding StatusIcon}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="{Binding StatusLabel}" />
                                </Border>

                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Base}"
                                           Margin="{StaticResource Grid.CellGap}"
                                           VerticalAlignment="Center"
                                           FontWeight="{StaticResource Weight.Medium}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding FileName}" ToolTip="{Binding FullPath}" />

                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}"
                                           Margin="{StaticResource Grid.CellGap}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding DirectoryPath}" />

                                <TextBlock Grid.Column="3" Style="{StaticResource Text.Base}"
                                           Margin="{StaticResource Grid.CellGap}"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Brush.Fg2}"
                                           Text="{Binding Format}" />

                                <TextBlock Grid.Column="4" Style="{StaticResource Text.Number}"
                                           Margin="{StaticResource Grid.CellGap}"
                                           VerticalAlignment="Center" FontSize="12"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource Brush.Fg2}"
                                           Text="{Binding Size}" />

                                <!-- Status badge with a word. The icon is already in the first column, so it
                                     is not repeated inside the badge. -->
                                <Border Grid.Column="5" Style="{StaticResource Status.Pill}">
                                    <TextBlock Text="{Binding StatusLabel}"
                                               FontSize="11.5"
                                               FontWeight="{StaticResource Weight.Semi}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding TotalCount, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}">
                    <c:MsIcon Kind="table" Size="32" HorizontalAlignment="Center"
                              Foreground="{DynamicResource Brush.Fg3}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Text="{svc:T Results_Empty}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Details and playlists ═════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Details of the selected file: human wording, technical cause on the second
                 line. -->
            <Border Grid.Column="0" Style="{StaticResource Details.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Results_Details}" />

                    <TextBlock Margin="0,7,0,0"
                               FontSize="13.5" FontWeight="{StaticResource Weight.Semi}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                <Setter Property="Text" Value="{Binding Selected.DetailsTitle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{svc:T Results_NoSelection}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Text" Value="{Binding Selected.Description}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{svc:T Results_NoSelection_Note}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding Selected.TechnicalDetail}"
                               Visibility="{Binding Selected.TechnicalDetail, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Playlist summary -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Results_Playlists}" />

                    <DockPanel LastChildFill="False" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Base}" Text="{svc:T Results_Found}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Number}"
                                   FontWeight="{StaticResource Weight.Semi}"
                                   Text="{Binding PlaylistCount, Converter={StaticResource NumberFormat}}" />
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,5,0,0">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Base}"
                                   Foreground="{DynamicResource Brush.Fg2}" Text="{svc:T Results_BrokenLinks}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Number}"
                                   FontWeight="{StaticResource Weight.Semi}"
                                   Foreground="{DynamicResource Brush.Err}"
                                   Text="{Binding PlaylistMissingCount, Converter={StaticResource NumberFormat}}" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{svc:T Results_PlaylistNote}"
                               Visibility="{Binding PlaylistCount, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
