<UserControl x:Class="MusicScanIntegrity.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:MusicScanIntegrity.App.Services"
             xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
             xmlns:vm="clr-namespace:MusicScanIntegrity.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Background="{DynamicResource Brush.Bg}"
             c:Motion.Entrance="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="22" MinHeight="470">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Four KPI cards ═══════════════════════════════════════════ -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" DataContext="{Binding Report}">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T ReportTab_TotalFiles}" />
                    <TextBlock Style="{StaticResource Text.Kpi}" Margin="0,8,0,0" Text="{Binding TotalFiles}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" FontSize="12" Margin="0,2,0,0"
                               Text="{Binding TotalFilesNote}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T ReportTab_Corrupted}" />
                    <TextBlock Style="{StaticResource Text.Kpi}" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.Err}" Text="{Binding CorruptedCount}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" FontSize="12" Margin="0,2,0,0"
                               Text="{Binding CorruptedNote}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T ReportTab_NeedAttention}" />
                    <TextBlock Style="{StaticResource Text.Kpi}" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.Warn}" Text="{Binding WarningCount}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" FontSize="12" Margin="0,2,0,0"
                               Text="{svc:T ReportTab_NeedAttention_Note}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T ReportTab_ScanTime}" />
                    <TextBlock Style="{StaticResource Text.Kpi}" Margin="0,8,0,0" Text="{Binding Elapsed}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" FontSize="12" Margin="0,2,0,0"
                               Text="{Binding ElapsedNote}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══ Status breakdown ═════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card.Padded}" DataContext="{Binding Report}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.BlockTitle}" Text="{svc:T ReportTab_Distribution}" />

                <!-- Bar segments are proportional to the counts with a 2 px gap, and only the
                     outer ends are rounded. Border does not clip content to its corner
                     radius, so the shape comes from an opacity mask with the same radius. -->
                <Border Margin="0,14,0,0" Height="14" CornerRadius="7"
                        Background="{DynamicResource Brush.Bd2}">
                    <Grid x:Name="DistributionBar">
                        <Grid.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Background="Black" CornerRadius="7"
                                            Width="{Binding ActualWidth, ElementName=DistributionBar}"
                                            Height="{Binding ActualHeight, ElementName=DistributionBar}" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding OkShare, Converter={StaticResource ShareToWidth}}" />
                            <ColumnDefinition Width="{Binding CorruptedShare, Converter={StaticResource ShareToWidth}}" />
                            <ColumnDefinition Width="{Binding WarningShare, Converter={StaticResource ShareToWidth}}" />
                            <ColumnDefinition Width="{Binding SkippedShare, Converter={StaticResource ShareToWidth}}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Ok}" Margin="0,0,1,0" />
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Err}" Margin="1,0" />
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Warn}" Margin="1,0" />
                        <Border Grid.Column="3" Background="{DynamicResource Brush.Skip}" Margin="1,0,0,0" />
                    </Grid>
                </Border>

                <UniformGrid Rows="1" Columns="4" Margin="0,16,0,0">
                    <DockPanel LastChildFill="False" Margin="0,0,12,0">
                        <Rectangle DockPanel.Dock="Left" Width="10" Height="10" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Fill="{DynamicResource Brush.Ok}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" Text="{svc:T Ui_Ok}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Number}"
                                   FontWeight="{StaticResource Weight.Semi}" Text="{Binding OkLabel}" />
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,12,0">
                        <Rectangle DockPanel.Dock="Left" Width="10" Height="10" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Fill="{DynamicResource Brush.Err}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" Text="{svc:T Ui_Corrupted}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Number}"
                                   FontWeight="{StaticResource Weight.Semi}" Text="{Binding CorruptedLabel}" />
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,12,0">
                        <Rectangle DockPanel.Dock="Left" Width="10" Height="10" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Fill="{DynamicResource Brush.Warn}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" Text="{svc:T Ui_Warnings}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Number}"
                                   FontWeight="{StaticResource Weight.Semi}" Text="{Binding WarningLabel}" />
                    </DockPanel>

                    <DockPanel LastChildFill="False">
                        <Rectangle DockPanel.Dock="Left" Width="10" Height="10" RadiusX="3" RadiusY="3"
                                   VerticalAlignment="Center" Fill="{DynamicResource Brush.Skip}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" Text="{svc:T Ui_Skipped}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Number}"
                                   FontWeight="{StaticResource Weight.Semi}" Text="{Binding SkippedLabel}" />
                    </DockPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ══ Folders and report saving ════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,13"
                            BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource Text.BlockTitle}" Text="{svc:T ReportTab_Folders}" />
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Report.Folders}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportViewModel+FolderRow}">
                                <DockPanel LastChildFill="False" Margin="18,11">
                                    <!-- Red only for a real finding: a red dash for "no corrupted files" would be
                                         a false alarm. -->
                                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                               Text="{Binding Bad}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Number}">
                                                <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
                                                <Setter Property="FontWeight" Value="{StaticResource Weight.Semi}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Fg3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBad}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Tertiary}"
                                               FontSize="{StaticResource Size.Secondary}" Margin="0,0,12,0"
                                               Text="{Binding Files}" />
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Mono}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Fg2}"
                                               Text="{Binding Path}" ToolTip="{Binding FullPath}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Margin="18,0,18,11"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Text="{Binding Report.FoldersNote}"
                               Visibility="{Binding Report.FoldersNote, Converter={StaticResource NotEmptyToVisibility}}" />

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Report.HasSummary, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <c:MsIcon Kind="stats" Size="32" HorizontalAlignment="Center"
                                  Foreground="{DynamicResource Brush.Fg3}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{svc:T ReportTab_Empty}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Format choice and saving -->
            <Border Grid.Column="2" Style="{StaticResource Card.Padded}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.BlockTitle}" Text="{svc:T ReportTab_SaveReport}" />

                    <!-- Format, contents and path are chosen in the save dialog. The format cards
                         used to appear both here and there, asking the same question twice. -->
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Margin="0,14,0,0" Text="{svc:T ReportTab_DefaultFormat}" />
                    <TextBlock Style="{StaticResource Text.Base}" Margin="0,6,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource EnumDisplay}">
                                <Binding Path="Report.SelectedFormat" />
                                <Binding Path="[Settings_Language]" Source="{x:Static svc:Loc.Instance}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Style="{StaticResource Text.Eyebrow}" Margin="0,14,0,0" Text="{svc:T ReportTab_Folder}" />
                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Fg2}"
                               Text="{Binding Report.TargetFolder}" />

                    <Button Style="{StaticResource Button.Accent}" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" Padding="10"
                            Content="{svc:T ReportTab_SaveEllipsis}" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Collection findings ══════════════════════════════════════
             A separate card rather than table rows: a numbering gap belongs to an
             album and a duplicate to a pair of files, never to a single file. -->
        <Border Grid.Row="6" Style="{StaticResource Card}" ClipToBounds="True"
                Visibility="{Binding Report.HasFindings, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="18,13"
                        BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource Text.BlockTitle}" Text="{svc:T ReportTab_CollectionFindings}" />
                </Border>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Report.Findings}"
                              MaxHeight="260"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1"
                                    Padding="18,11">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.WarnBg}"
                                            CornerRadius="{StaticResource Radius.Pill}"
                                            Padding="10,3" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Text.Tertiary}"
                                                   FontWeight="{StaticResource Weight.Semi}"
                                                   Foreground="{DynamicResource Brush.Warn}"
                                                   Text="{Binding KindLabel}" />
                                    </Border>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Base}" TextWrapping="Wrap"
                                                   Text="{Binding Message}" />
                                        <TextBlock Style="{StaticResource Text.Mono}" Margin="0,3,0,0"
                                                   FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Fg3}"
                                                   Text="{Binding Path}" ToolTip="{Binding Path}" />
                                        <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" Text="{Binding Detail}"
                                                   Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Style="{StaticResource Text.Tertiary}" Margin="18,11"
                           TextWrapping="Wrap" Text="{Binding Report.FindingsNote}"
                           Visibility="{Binding Report.FindingsNote, Converter={StaticResource NotEmptyToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
