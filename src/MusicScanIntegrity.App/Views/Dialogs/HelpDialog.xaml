<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.HelpDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:svc="clr-namespace:MusicScanIntegrity.App.Services"
                 xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{svc:T Ui_Help}"
                 Width="460" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}"
                 PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock Text="{svc:T Ui_Help}" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Help_Statuses}" />

                <StackPanel Margin="0,10,0,0">
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.OkBg}">
                            <c:MsIcon Kind="status-ok" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Ok}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="{svc:T Ui_Ok}" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="{svc:T Help_Ok}" />
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.ErrBg}">
                            <c:MsIcon Kind="status-broken" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Err}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="{svc:T Help_CorruptedName}" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="{svc:T Help_Corrupted}" />
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.WarnBg}">
                            <c:MsIcon Kind="status-warning" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Warn}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="{svc:T Help_WarningName}" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="{svc:T Help_Warning}" />
                        </TextBlock>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.SkipBg}">
                            <c:MsIcon Kind="status-skipped" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Skip}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="{svc:T Help_SkippedName}" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="{svc:T Help_Skipped}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Help_HowItWorks}" Margin="0,20,0,0" />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="{svc:T Help_HowItWorks_Decode}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{svc:T Help_HowItWorks_Playlists}" />

                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{svc:T Help_Shortcuts}" Margin="0,20,0,0" />
                <StackPanel Margin="0,10,0,0">
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="{svc:T Ui_PickFolder}" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + O" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="{svc:T Ui_StartScan}" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="F5" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="{svc:T Ui_Rescan}" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + R" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="{svc:T ReportTab_SaveReport}" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + S" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="{svc:T Ui_Settings}" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + ," />
                        </Border>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
