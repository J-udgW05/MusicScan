<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.HelpDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Справка"
                 Width="460" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}"
                 PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock Text="Справка" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="ЧТО ОЗНАЧАЮТ СТАТУСЫ" />

                <StackPanel Margin="0,10,0,0">
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.OkBg}">
                            <c:MsIcon Kind="status-ok" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Ok}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="В порядке" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="— файл прочитан и декодирован без ошибок." />
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.ErrBg}">
                            <c:MsIcon Kind="status-broken" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Err}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="Повреждён" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="— декодер прервался, поток битый, файл пустой или до него не удалось добраться. Такие файлы стоит перекачать." />
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.WarnBg}">
                            <c:MsIcon Kind="status-warning" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Warn}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="Предупреждение" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="— файл читается, но что-то странно: нет тегов, расширение не совпадает с содержимым, проверка затянулась. Это не повреждение." />
                        </TextBlock>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.SkipBg}">
                            <c:MsIcon Kind="status-skipped" Size="15" StrokeWeight="1.7"
                                      Foreground="{DynamicResource Brush.Skip}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}"
                                   Margin="11,0,0,0" TextWrapping="Wrap">
                            <Run Text="Пропущен" FontWeight="{StaticResource Weight.Semi}"
                                 Foreground="{DynamicResource Brush.Fg}" />
                            <Run Text="— файл был занят другой программой и пропущен по вашему решению." />
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="КАК ЭТО РАБОТАЕТ" Margin="0,20,0,0" />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Программа не просто смотрит на расширение - а пытается декодировать первые две секунды каждого файла. Если декодер не справился, файл действительно повреждён. Проверка идёт в несколько потоков." />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Плейлисты (M3U, M3U8, PLS, CUE) проверяются иначе: в них проверяет только, существуют ли файлы, на которые они ссылаются. Один и тот же файл, встретившийся и в папке, и в плейлисте, получает один статус." />

                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="ГОРЯЧИЕ КЛАВИШИ" Margin="0,20,0,0" />
                <StackPanel Margin="0,10,0,0">
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="Выбрать папку" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + O" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="Начать проверку" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="F5" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="Проверить заново" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + R" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="Экспорт отчёта" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + S" />
                        </Border>
                    </DockPanel>

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="Настройки" />
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                                CornerRadius="4" Padding="7,3">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Foreground="{DynamicResource Brush.Fg}" Text="Ctrl + ," />
                        </Border>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
