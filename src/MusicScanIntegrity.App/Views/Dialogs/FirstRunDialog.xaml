<!-- MinHeight=0: FluentWindow defaults to 320, sized for the main window, which
     left an empty strip under the buttons of a dialog that sizes to content.
     Width is left alone: the dialogs are laid out for FluentWindow's width. -->
<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.FirstRunDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:svc="clr-namespace:MusicScanIntegrity.App.Services"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{svc:T FirstRun_Title}"
                 Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 MinHeight="0"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock Text="{svc:T FirstRun_Title}" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,20">
            <TextBlock Text="{svc:T FirstRun_Lead}"
                       FontSize="17" FontWeight="{StaticResource Weight.Semi}"
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Fg}" />

            <StackPanel Margin="0,16,0,0">
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.AccSoft}">
                        <TextBlock Text="1" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Acc}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource Text.BlockTitle}" Text="{svc:T FirstRun_Step1}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" FontSize="12"
                                   TextWrapping="Wrap" Text="{svc:T FirstRun_Step1_Note}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.AccSoft}">
                        <TextBlock Text="2" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Acc}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource Text.BlockTitle}" Text="{svc:T FirstRun_Step2}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{svc:T FirstRun_Step2_Note}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.AccSoft}">
                        <TextBlock Text="3" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Acc}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource Text.BlockTitle}" Text="{svc:T FirstRun_Step3}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{svc:T FirstRun_Step3_Note}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <CheckBox x:Name="DoNotShow" Style="{StaticResource CheckBox.Square}" Margin="0,18,0,0">
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{svc:T FirstRun_DontShow}" />
            </CheckBox>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Mica}"
                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="0,1,0,0"
                Padding="18,13">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Padding="18,8"
                        Content="{svc:T Ui_PickFolder}" IsDefault="True" Click="OnPickFolder" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}"
                        Margin="0,0,10,0" Padding="16,8" Content="{svc:T FirstRun_Later}" IsCancel="True" Click="OnLater" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
