<!-- MinHeight=0: у FluentWindow минимум 320 точек, рассчитанный на главное окно.
     Диалог растёт по содержимому, и этот минимум оставлял под кнопками пустую
     полосу. Ширина не трогается: диалоги нарисованы под ту, что даёт FluentWindow. -->
<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.ColorPickDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Цвет статуса"
                 Width="380" SizeToContent="Height" ResizeMode="NoResize"
                 MinHeight="0"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock x:Name="TitleText" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <StackPanel Grid.Row="1" Margin="18">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Preview" Width="44" Height="44" CornerRadius="10"
                        BorderBrush="#22000000" BorderThickness="1" />
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LabelText" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                               Text="Ведите мышью по полю или введите код цвета" />
                </StackPanel>
            </StackPanel>

            <!-- Поле насыщенности и яркости: по горизонтали цвет разбавляется
                 белым, по вертикали уходит в чёрный. Оттенок задаётся полосой
                 ниже и подставляется в подложку этого поля. -->
            <Grid x:Name="Area" Height="150" Margin="0,16,0,0"
                  Cursor="Cross"
                  MouseLeftButtonDown="OnAreaDown" MouseMove="OnAreaMove" MouseLeftButtonUp="OnAreaUp">
                <Border x:Name="AreaHue" CornerRadius="8" />

                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#FF000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="8" BorderBrush="#33000000" BorderThickness="1" />

                <Canvas>
                    <Ellipse x:Name="AreaThumb" Width="16" Height="16" IsHitTestVisible="False"
                             Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.55" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Полоса оттенка. -->
            <Grid x:Name="Hue" Height="18" Margin="0,12,0,0"
                  Cursor="Cross"
                  MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnHueUp">
                <Border CornerRadius="9" BorderBrush="#33000000" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.00" Color="#FFFF0000" />
                            <GradientStop Offset="0.17" Color="#FFFFFF00" />
                            <GradientStop Offset="0.33" Color="#FF00FF00" />
                            <GradientStop Offset="0.50" Color="#FF00FFFF" />
                            <GradientStop Offset="0.67" Color="#FF0000FF" />
                            <GradientStop Offset="0.83" Color="#FFFF00FF" />
                            <GradientStop Offset="1.00" Color="#FFFF0000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Canvas>
                    <Border x:Name="HueThumb" Width="8" Height="18" CornerRadius="4"
                            IsHitTestVisible="False"
                            Background="Transparent" BorderBrush="White" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.55" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <TextBlock Style="{StaticResource Text.Eyebrow}" Text="ГОТОВЫЕ ОТТЕНКИ" Margin="0,16,0,6" />
            <ItemsControl x:Name="Swatches">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="30" Height="30" Margin="0,0,7,7"
                                Click="OnSwatchClick" Tag="{Binding}"
                                ToolTip="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="7" BorderBrush="#22000000" BorderThickness="1"
                                            Background="{Binding Converter={StaticResource HexToBrush}}" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Eyebrow}" Text="КОД ЦВЕТА (#RRGGBB)" Margin="0,8,0,6" />
            <TextBox x:Name="HexBox" Style="{StaticResource TextBox.Field}"
                     FontFamily="{StaticResource Font.Mono}"
                     AutomationProperties.Name="Код цвета"
                     TextChanged="OnHexChanged" />

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Tertiary}" Margin="0,6,0,0"
                       Foreground="{DynamicResource Brush.Err}" Visibility="Collapsed"
                       Text="Не похоже на цвет. Нужен вид #RRGGBB, например #0F7B3F." />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Mica}"
                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="0,1,0,0"
                Padding="18,13">
            <DockPanel LastChildFill="False">
                <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource Button.Accent}"
                        Padding="18,8" Content="Применить" IsDefault="True" Click="OnApply" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}"
                        Margin="0,0,10,0" Padding="16,8" Content="Отмена" IsCancel="True" Click="OnCancel" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
