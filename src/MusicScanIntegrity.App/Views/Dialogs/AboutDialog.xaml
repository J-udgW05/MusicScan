<!-- MinHeight=0: у FluentWindow минимум 320 точек, рассчитанный на главное окно.
     Диалог растёт по содержимому, и этот минимум оставлял под кнопками пустую
     полосу. Ширина не трогается: диалоги нарисованы под ту, что даёт FluentWindow. -->
<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.AboutDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="О программе"
                 Width="400" SizeToContent="Height" ResizeMode="NoResize"
                 MinHeight="0"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock Text="О программе" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,20">
            <StackPanel Orientation="Horizontal">
                <!-- Здесь места хватает, поэтому знак крупный. -->
                <Image x:Name="Logo" Width="64" Height="64"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Music Scan Integrity" FontSize="16"
                               FontWeight="{StaticResource Weight.Semi}"
                               Foreground="{DynamicResource Brush.Fg}" />
                    <TextBlock x:Name="VersionLine" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="Проверка музыкальной коллекции на повреждённые файлы." />

            <Border BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,1,0,0"
                    Margin="0,14,0,0" Padding="0,12,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,7">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}"
                                   Foreground="{DynamicResource Brush.Fg3}" Text="Сборка" />
                        <TextBlock x:Name="BuildLine" DockPanel.Dock="Right" Style="{StaticResource Text.Mono}"
                                   Foreground="{DynamicResource Brush.Fg}" />
                    </DockPanel>

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}"
                                   Foreground="{DynamicResource Brush.Fg3}" Text="Декодирование" />
                        <TextBlock x:Name="AudioLine" DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}"
                                   Foreground="{DynamicResource Brush.Fg}" />
                    </DockPanel>

                    <TextBlock x:Name="PluginsLine" Style="{StaticResource Text.Mono}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" CornerRadius="7" Padding="13,11"
                    Background="{DynamicResource Brush.Card2}"
                    BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1">
                <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                           Text="Компоненты: BASS — декодирование аудио; TagLib# — чтение тегов; WPF-UI — оформление окна." />
            </Border>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
