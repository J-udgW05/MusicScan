<!-- MinHeight=0: у FluentWindow минимум 320 точек, рассчитанный на главное окно.
     Диалог растёт по содержимому, и этот минимум оставлял под кнопками пустую
     полосу. Ширина не трогается: диалоги нарисованы под ту, что даёт FluentWindow. -->
<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.MessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="420" SizeToContent="Height" ResizeMode="NoResize"
                 MinHeight="0"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна диалога: 38px (UI_SPEC.md, раздел 4). -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock x:Name="TitleText" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <!-- Содержимое -->
        <StackPanel Grid.Row="1" Margin="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBox" Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Brush.WarnBg}">
                    <c:MsIcon x:Name="StatusIcon" Kind="status-warning" Size="18"
                              Foreground="{DynamicResource Brush.Warn}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                    <TextBlock x:Name="HeadlineText" Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Техническая причина — отдельным блоком, не в основном тексте. -->
            <Border x:Name="DetailBox" Margin="0,14,0,0" CornerRadius="7" Padding="13,11"
                    Background="{DynamicResource Brush.Card2}"
                    BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="ТЕХНИЧЕСКАЯ ПРИЧИНА" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource Text.Mono}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Подвал: второстепенное слева, основное действие справа (UI_SPEC.md, раздел 12). -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Mica}"
                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="0,1,0,0"
                Padding="18,13">
            <DockPanel LastChildFill="False">
                <!-- Слева — необязательное вспомогательное действие: скопировать
                     путь, чтобы его можно было отнести в проводник или в права
                     доступа, не переписывая руками. -->
                <Button x:Name="CopyButton" DockPanel.Dock="Left"
                        Style="{StaticResource Button.Outline}" Padding="14,8"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Скопировать путь"
                        Click="OnCopyPath">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="copy" Size="15" VerticalAlignment="Center" />
                        <TextBlock Text="Скопировать путь" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ConfirmButton" DockPanel.Dock="Right"
                        Style="{StaticResource Button.Accent}" Padding="18,8"
                        IsDefault="True" Click="OnConfirm" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right"
                        Style="{StaticResource Button.Outline}" Margin="0,0,10,0" Padding="16,8"
                        IsCancel="True" Click="OnCancel" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
