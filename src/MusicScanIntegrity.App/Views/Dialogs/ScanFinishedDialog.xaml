<!-- MinHeight=0: FluentWindow defaults to 320, sized for the main window, which
     left an empty strip under the buttons of a dialog that sizes to content.
     Width is left alone: the dialogs are laid out for FluentWindow's width. -->
<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.ScanFinishedDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Проверка завершена"
                 Width="400" SizeToContent="Height" ResizeMode="NoResize"
                 MinHeight="0"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}"
                 PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock x:Name="TitleText" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <StackPanel Grid.Row="1" Margin="18">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBox" Width="30" Height="30" CornerRadius="8"
                        Background="{DynamicResource Brush.OkBg}">
                    <c:MsIcon x:Name="StatusIcon" Kind="status-ok" Size="19" StrokeWeight="1.6"
                              Foreground="{DynamicResource Brush.Ok}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadlineText" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock x:Name="ElapsedText" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Four totals: colour plus word. -->
            <UniformGrid Rows="2" Columns="2" Margin="0,16,0,0">
                <Border CornerRadius="8" Padding="12" Margin="0,0,4,4"
                        Background="{DynamicResource Brush.ErrBg}"
                        BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="CorruptedValue" Style="{StaticResource Text.DialogNumber}"
                                   Foreground="{DynamicResource Brush.Err}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.Fg2}" Text="повреждено" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="12" Margin="4,0,0,4"
                        Background="{DynamicResource Brush.WarnBg}"
                        BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="WarningValue" Style="{StaticResource Text.DialogNumber}"
                                   Foreground="{DynamicResource Brush.Warn}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.Fg2}" Text="требуют внимания" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="12" Margin="0,4,4,0"
                        Background="{DynamicResource Brush.SkipBg}"
                        BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="SkippedValue" Style="{StaticResource Text.DialogNumber}"
                                   Foreground="{DynamicResource Brush.Skip}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.Fg2}" Text="пропущено" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="12" Margin="4,4,0,0"
                        Background="{DynamicResource Brush.OkBg}"
                        BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="OkValue" Style="{StaticResource Text.DialogNumber}"
                                   Foreground="{DynamicResource Brush.Ok}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.Fg2}" Text="в порядке" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock x:Name="StoppedNote" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource Brush.Warn}"
                       Text="Проверка была остановлена — в итог попало только то, что успели проверить." />

            <TextBlock x:Name="PlaylistNote" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Mica}"
                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="0,1,0,0"
                Padding="18,13">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Outline}" Padding="14,8"
                        Click="OnOpenFolder">
                    <StackPanel Orientation="Horizontal">
                        <c:MsIcon Kind="open-external" Size="15" VerticalAlignment="Center" />
                        <TextBlock Text="Открыть папку" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Padding="16,8"
                        Content="К результатам" IsDefault="True" Click="OnGoToResults" />

                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}"
                        Margin="0,0,10,0" Padding="14,8"
                        Content="Отчёт" Click="OnGoToReport" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
