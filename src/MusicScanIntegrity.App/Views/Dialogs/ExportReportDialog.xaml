<!-- MinHeight=0: FluentWindow defaults to 320, sized for the main window, which
     left an empty strip under the buttons of a dialog that sizes to content.
     Width is left alone: the dialogs are laid out for FluentWindow's width. -->
<ui:FluentWindow x:Class="MusicScanIntegrity.App.Views.Dialogs.ExportReportDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:MusicScanIntegrity.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Экспорт отчёта"
                 Width="420" SizeToContent="Height" ResizeMode="NoResize"
                 MinHeight="0"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round"
                 FontFamily="{StaticResource Font.Ui}"
                 Background="{DynamicResource Brush.Bg}"
                 Foreground="{DynamicResource Brush.Fg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Bd2}" BorderThickness="0,0,0,1">
            <ui:TitleBar Height="38" ButtonsForeground="{DynamicResource Brush.Fg2}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Header>
                    <TextBlock Text="Экспорт отчёта" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.TitleBar}"
                               Foreground="{DynamicResource Brush.Fg2}" />
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <StackPanel Grid.Row="1" Margin="18">
            <TextBlock Style="{StaticResource Text.Eyebrow}" Text="ФОРМАТ" />

            <RadioButton x:Name="HtmlOption" Style="{StaticResource Radio.Dot}" GroupName="Fmt" Margin="0,9,0,0"
                         Checked="OnFormatChanged">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.BlockTitle}" Text="HTML-страница" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                               Text="С той же цветовой маркировкой, открывается в браузере" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="CsvOption" Style="{StaticResource Radio.Dot}" GroupName="Fmt" Margin="0,7,0,0"
                         Checked="OnFormatChanged">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.BlockTitle}" Text="Таблица CSV" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                               Text="Для Excel и дальнейшей обработки" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="TextOption" Style="{StaticResource Radio.Dot}" GroupName="Fmt" Margin="0,7,0,0"
                         Checked="OnFormatChanged">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.BlockTitle}" Text="Текстовый список" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                               Text="Читать глазами, только проблемные файлы" />
                </StackPanel>
            </RadioButton>

            <TextBlock Style="{StaticResource Text.Eyebrow}" Text="ЧТО ВКЛЮЧИТЬ" Margin="0,18,0,0" />

            <CheckBox x:Name="IncludeCorrupted" Style="{StaticResource CheckBox.Square}" Margin="0,10,0,0" IsChecked="True">
                <TextBlock>
                    <Run Text="Повреждённые файлы" Foreground="{DynamicResource Brush.Fg}" />
                    <Run x:Name="CorruptedCount" Foreground="{DynamicResource Brush.Fg3}" />
                </TextBlock>
            </CheckBox>

            <CheckBox x:Name="IncludeWarnings" Style="{StaticResource CheckBox.Square}" Margin="0,9,0,0" IsChecked="True">
                <TextBlock>
                    <Run Text="Предупреждения и пропущенные" Foreground="{DynamicResource Brush.Fg}" />
                    <Run x:Name="WarningCount" Foreground="{DynamicResource Brush.Fg3}" />
                </TextBlock>
            </CheckBox>

            <CheckBox x:Name="IncludeOk" Style="{StaticResource CheckBox.Square}" Margin="0,9,0,0">
                <TextBlock>
                    <Run Text="Файлы «в порядке»" Foreground="{DynamicResource Brush.Fg2}" />
                    <Run x:Name="OkCount" Foreground="{DynamicResource Brush.Fg3}" />
                </TextBlock>
            </CheckBox>

            <CheckBox x:Name="IncludePlaylists" Style="{StaticResource CheckBox.Square}" Margin="0,9,0,0" IsChecked="True">
                <TextBlock>
                    <Run Text="Битые ссылки плейлистов" Foreground="{DynamicResource Brush.Fg}" />
                    <Run x:Name="PlaylistCount" Foreground="{DynamicResource Brush.Fg3}" />
                </TextBlock>
            </CheckBox>

            <Border Margin="0,16,0,0" CornerRadius="7" Padding="13,11"
                    Background="{DynamicResource Brush.Card2}"
                    BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="280">
                        <TextBlock Style="{StaticResource Text.Tertiary}" Text="Сохранить в" />
                        <TextBlock x:Name="TargetPath" Style="{StaticResource Text.Mono}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Fg}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}"
                            VerticalAlignment="Center" Content="Изменить…" Click="OnChangePath" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Mica}"
                BorderBrush="{DynamicResource Brush.Bd}" BorderThickness="0,1,0,0"
                Padding="18,13">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Padding="18,8"
                        Content="Сохранить" IsDefault="True" Click="OnSave" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}"
                        Margin="0,0,10,0" Padding="16,8" Content="Отмена" IsCancel="True" Click="OnCancel" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
