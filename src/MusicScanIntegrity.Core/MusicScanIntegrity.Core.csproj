<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MusicScanIntegrity.Core</RootNamespace>
    <AssemblyName>MusicScanIntegrity.Core</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <!-- The core has no WPF dependency so it can be fully unit tested. The
         Windows TFM is only needed for Restart Manager (P/Invoke into RstrtMgr.dll). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="TagLibSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicScanIntegrity.Core.Tests" />
  </ItemGroup>

</Project>
